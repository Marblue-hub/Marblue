          }
        ],
        "partitions": [
          {
            "name": "fact_order_items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "LoadData(\"fact_order_items\")"
            }
          }
        ]
      },
      {
        "name": "build_metadata",
        "lineageTag": "9ccee1ff-db3a-5636-83f4-825c2e9f7813",
        "columns": [
          {
            "name": "loaded_at_utc",
            "dataType": "string",
            "sourceColumn": "loaded_at_utc",
            "lineageTag": "13e24caf-40c5-518c-806b-f94e512a7980",
            "summarizeBy": "none"
          },
          {
            "name": "source_sha256",
            "dataType": "string",
            "sourceColumn": "source_sha256",
            "lineageTag": "4f2c3df5-07ac-5a3c-af7a-218010e60580",
            "summarizeBy": "none"
          },
          {
            "name": "rule_version",
            "dataType": "string",
            "sourceColumn": "rule_version",
            "lineageTag": "fa6041cd-9f20-5e2c-809e-476b0ec8fc80",
            "summarizeBy": "none"
          },
          {
            "name": "sales_field",
            "dataType": "string",
            "sourceColumn": "sales_field",
            "lineageTag": "53196fd7-7a6e-5074-b2bf-f6702fa5fa9a",
