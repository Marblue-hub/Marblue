        "isHidden": true
      },
      {
        "name": "KPI",
        "lineageTag": "12677691-9e5c-55e6-ba82-fa71115caa4a",
        "columns": [
          {
            "name": "Dummy",
            "dataType": "int64",
            "sourceColumn": "Dummy",
            "isHidden": true,
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Orders",
            "expression": "VAR SelectedOrderIds = VALUES(fact_order_items[order_id])\nRETURN COALESCE(CALCULATE(COUNTROWS(fact_orders), TREATAS(SelectedOrderIds, fact_orders[order_id])), 0)",
            "lineageTag": "218b8565-2369-5533-b28b-aaa2c090fd5a",
            "displayFolder": "业务指标",
            "description": "独立订单数",
            "formatString": "#,0"
          },
          {
            "name": "Order Items",
            "expression": "COALESCE(COUNTROWS(fact_order_items), 0)",
            "lineageTag": "9bd5c168-5828-5534-833f-eb9a77f3aa44",
            "displayFolder": "业务指标",
            "description": "订单明细数",
            "formatString": "#,0"
          },
          {
            "name": "Recorded Discount",
            "expression": "SUM(fact_order_items[discount])",
            "lineageTag": "4d99939b-26aa-5f87-b888-18fdd86fe7b3",
            "displayFolder": "业务指标",
            "description": "Recorded Discount",
            "formatString": "#,0"
          },
          {
            "name": "Conflict Orders",
            "expression": "CALCULATE([Orders], KEEPFILTERS(fact_orders[is_order_conflict] == 1))",
            "lineageTag": "bb2d529d-00a4-58a3-a263-7a2c08ead3d8",
            "displayFolder": "业务指标",
            "description": "Conflict Orders",
            "formatString": "#,0"
          },
          {
            "name": "Sales",
            "expression": "SUM(fact_order_items[sales])",
            "lineageTag": "9808ae8b-656a-5afe-b2c0-a52de542ab0e",
            "displayFolder": "业务指标",
            "description": "记录销售额（折扣后）",
            "formatString": "#,0.00"
          },
          {
            "name": "Gross Sales",
            "expression": "SUM(fact_order_items[gross_sales])",
            "lineageTag": "e7f09147-b94e-5f3f-b528-83da7cbe5f72",
            "displayFolder": "业务指标",
            "description": "折扣前金额",
            "formatString": "#,0.00"
          },
          {
            "name": "Reported Profit",
            "expression": "SUM(fact_order_items[reported_profit])",
            "lineageTag": "3c288c8f-5e77-5de0-9a82-6b85d54fef9b",
            "displayFolder": "业务指标",
            "description": "记录利润",
            "formatString": "#,0.00"
          },
          {
            "name": "Reported Profit Margin",
            "expression": "DIVIDE([Reported Profit], [Sales])",
            "lineageTag": "62694a49-6aac-5eb5-b3f1-248ee899839d",
            "displayFolder": "业务指标",
            "description": "记录利润率",
            "formatString": "0.00%"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Sales], [Orders])",
            "lineageTag": "e4c04eec-fe06-5467-af12-dbc4aeec468f",
            "displayFolder": "业务指标",
            "description": "订单客单价",
            "formatString": "#,0.00"
          },
          {
            "name": "Canceled Orders",
            "expression": "CALCULATE([Orders], KEEPFILTERS(fact_orders[is_canceled] = 1))",
            "lineageTag": "0a3050f3-f939-5035-8602-5d2b8214c06e",
            "displayFolder": "业务指标",
            "description": "Canceled Orders",
            "formatString": "#,0"
          },
          {
            "name": "Canceled Order Rate",
            "expression": "DIVIDE([Canceled Orders], [Orders])",
            "lineageTag": "764a35c7-77af-55c2-8342-223c84410dfe",
            "displayFolder": "业务指标",
            "description": "运营取消率",
            "formatString": "0.00%"
          },
          {
            "name": "Eligible Orders",
            "expression": "CALCULATE([Orders], KEEPFILTERS(FILTER(fact_orders, NOT ISBLANK(fact_orders[is_over_schedule]))))",
            "lineageTag": "0d2aa720-1e2b-5ffc-93ce-10076d47b427",
            "displayFolder": "业务指标",
            "description": "有效未取消订单",
            "formatString": "#,0"
          },
          {
            "name": "Over Schedule Orders",
            "expression": "CALCULATE([Orders], KEEPFILTERS(fact_orders[is_over_schedule] == 1))",
            "lineageTag": "b741a3c0-8355-54a5-8ef8-0f221294b871",
            "displayFolder": "业务指标",
            "description": "超期订单数",
            "formatString": "#,0"
          },
          {
            "name": "Within Schedule Orders",
            "expression": "CALCULATE([Orders], KEEPFILTERS(fact_orders[is_over_schedule] == 0))",
            "lineageTag": "835af11e-ad10-5e83-b6e6-32994b819325",
            "displayFolder": "业务指标",
            "description": "Within Schedule Orders",
            "formatString": "#,0"
          },
          {
            "name": "Unknown Timing Orders",
            "expression": "[Orders] - [Canceled Orders] - [Eligible Orders]",
            "lineageTag": "38381f9a-e570-5da6-b4fc-a2f535247860",
            "displayFolder": "业务指标",
            "description": "未知时效订单",
            "formatString": "#,0"
          },
          {
            "name": "Over Schedule Order Rate",
            "expression": "DIVIDE([Over Schedule Orders], [Eligible Orders])",
            "lineageTag": "b7802e79-01a2-5700-8fe5-933b82d6f5fb",
            "displayFolder": "业务指标",
            "description": "超期订单率",
            "formatString": "0.00%"
          },
          {
            "name": "Average Positive Over Days",
            "expression": "VAR SelectedOrderIds = VALUES(fact_order_items[order_id])\nRETURN CALCULATE(\n    AVERAGE(fact_orders[positive_over_days]),\n    TREATAS(SelectedOrderIds, fact_orders[order_id]),\n    KEEPFILTERS(fact_orders[is_over_schedule] == 1))",
            "lineageTag": "817ad87f-6397-5d9c-acea-80cd73c0de48",
            "displayFolder": "业务指标",
            "description": "平均正超期天数",
            "formatString": "#,0.00"
          },
          {
            "name": "Over Schedule Order Sales Exposure",
            "expression": "VAR SelectedOrderIds = VALUES(fact_order_items[order_id])\nRETURN CALCULATE(SUM(fact_orders[sales]),\n    TREATAS(SelectedOrderIds, fact_orders[order_id]),\n    KEEPFILTERS(fact_orders[is_over_schedule] == 1))",
            "lineageTag": "59109ba0-2ddc-5085-b4bf-32fdb7863f35",
            "displayFolder": "业务指标",
            "description": "Over Schedule Order Sales Exposure",
            "formatString": "#,0.00"
          },
          {
            "name": "Canceled Sales Exposure",
            "expression": "CALCULATE([Sales], KEEPFILTERS(fact_orders[is_canceled] == 1))",
            "lineageTag": "539518ea-2a21-526d-aca8-165dcf44e842",
            "displayFolder": "业务指标",
            "description": "Canceled Sales Exposure",
            "formatString": "#,0.00"
          },
          {
            "name": "Eligible Items",
            "expression": "CALCULATE([Order Items], KEEPFILTERS(FILTER(fact_orders, NOT ISBLANK(fact_orders[is_over_schedule]))))",
            "lineageTag": "8b6adda8-7b30-5275-b4b1-0a4ddb374f67",
            "displayFolder": "业务指标",
            "description": "Eligible Items",
            "formatString": "#,0"
          },
          {
            "name": "Over Schedule Items",
            "expression": "CALCULATE([Order Items], KEEPFILTERS(fact_orders[is_over_schedule] == 1))",
            "lineageTag": "f7c28ab0-2957-55cc-9cda-d6275f1b5c4b",
            "displayFolder": "业务指标",
            "description": "Over Schedule Items",
            "formatString": "#,0"
          },
          {
            "name": "Over Schedule Item Rate",
            "expression": "DIVIDE([Over Schedule Items], [Eligible Items])",
            "lineageTag": "b7c0a650-fc5f-570b-ae3e-a14f3a748749",
            "displayFolder": "业务指标",
            "description": "Over Schedule Item Rate",
            "formatString": "0.00%"
          },
          {
            "name": "Negative Profit Items",
            "expression": "CALCULATE([Order Items], KEEPFILTERS(fact_order_items[reported_profit] < 0))",
            "lineageTag": "0b4ea824-9c24-58a0-8f36-ba106b49ca33",
            "displayFolder": "业务指标",
            "description": "负利润明细数",
            "formatString": "#,0"
          },
          {
            "name": "Negative Profit Item Rate",
            "expression": "DIVIDE([Negative Profit Items], [Order Items])",
            "lineageTag": "657848ee-7226-5454-bcf6-89d8b096b9d4",
            "displayFolder": "业务指标",
            "description": "负利润明细比例",
            "formatString": "0.00%"
          },
          {
            "name": "Small Sample Note",
            "expression": "IF([Eligible Orders] < 100, \"小样本 <100\", BLANK())",
            "lineageTag": "5fa58be9-69a5-5910-a874-486dc55d1799",
            "displayFolder": "业务指标",
            "description": "样本提示"
          },
          {
            "name": "First Class Audit Note",
            "expression": "\"First Class 结果需验证计划规则和源字段定义；不可据此推断服务质量根因。\"",
            "lineageTag": "d486e3bd-d82d-5074-9741-dcf153f3c88f",
            "displayFolder": "业务指标",
            "description": "First Class Audit Note"
          },
          {
            "name": "Timing Definition",
            "expression": "\"未取消且时长有效的独立订单中，实际运输时长超过计划时长的比例。无最终签收时间。\"",
            "lineageTag": "1817f46e-21e9-5f24-98a0-7b4622c6c75f",
            "displayFolder": "业务指标",
            "description": "Timing Definition"
          },
          {
            "name": "Money Definition",
            "expression": "\"记录销售额采用 Order Item Total（折扣后）；币种待核验；记录利润不是财务净利润。\"",
            "lineageTag": "eb0a5a77-2d69-5ed7-9b44-06ff7af4c474",
            "displayFolder": "业务指标",
            "description": "Money Definition"
          },
          {
            "name": "Comparable Sales",
            "expression": "CALCULATE([Sales], KEEPFILTERS(dim_date[is_comparable] = 1))",
            "lineageTag": "c144029f-fbf2-506b-9492-e4dfb161a646",
            "displayFolder": "业务指标",
            "description": "Comparable Sales",
            "formatString": "#,0.00"
          },
          {
            "name": "Data Refresh UTC",
            "expression": "SELECTEDVALUE(build_metadata[loaded_at_utc])",
            "lineageTag": "de5c577d-7c54-509b-a087-b7ad86f1c1ee",
            "displayFolder": "业务指标",
            "description": "Data Refresh UTC"
          },
          {
            "name": "Sales Millions",
            "expression": "DIVIDE([Sales],1000000)",
            "lineageTag": "e543ce6b-624f-590f-ad81-a340cdbe6fe2",
            "displayFolder": "业务指标",
            "description": "记录销售额（百万）",
            "formatString": "#,0.00"
          },
          {
            "name": "Profit Millions",
            "expression": "DIVIDE([Reported Profit],1000000)",
            "lineageTag": "6d0205d9-3b4f-54b2-9313-7bd0452eb04b",
            "displayFolder": "业务指标",
            "description": "记录利润（百万）",
            "formatString": "#,0.00"
          },
          {
            "name": "Over Schedule Exposure Millions",
            "expression": "DIVIDE([Over Schedule Order Sales Exposure],1000000)",
            "lineageTag": "4b28af5c-24bf-5835-8c19-e84bc30844b7",
            "displayFolder": "业务指标",
            "description": "超期整篮金额（百万）",
            "formatString": "#,0.00"
          },
          {
            "name": "Customers",
            "expression": "VAR SelectedOrderIds=VALUES(fact_order_items[order_id])\nRETURN CALCULATE(DISTINCTCOUNT(fact_orders[customer_id]),TREATAS(SelectedOrderIds,fact_orders[order_id]))",
            "lineageTag": "e56c794c-0848-54c3-9746-068b6562fceb",
            "displayFolder": "业务指标",
            "description": "涉及客户数",
            "formatString": "#,0"
          },
          {
            "name": "Data Loaded UTC Display",
            "expression": "VAR Stamp=[Data Refresh UTC]\nRETURN LEFT(SUBSTITUTE(Stamp,\"T\",\" \"),19)&\" UTC\" ",
            "lineageTag": "6e6a5a47-dd77-5edb-834a-80028b88b0c6",
            "displayFolder": "业务指标",
            "description": "源数据载入时间（UTC）"
          },
          {
            "name": "Negative Profit Magnitude",
            "expression": "-CALCULATE([Reported Profit],KEEPFILTERS(fact_order_items[reported_profit]<0))",
            "lineageTag": "aa5afd92-0198-5ea9-9604-d79baea879cc",
            "displayFolder": "业务指标",
            "description": "负利润明细绝对额",
            "formatString": "#,0.00"
          },
          {
            "name": "Category Sales Rank",
            "expression": "RANKX(ALLSELECTED(dim_product[category]),[Sales],,DESC,DENSE)",
            "lineageTag": "bc2a6a27-9d24-574c-b9b5-d58478f7a095",
            "displayFolder": "业务指标",
            "description": "Category Sales Rank",
            "formatString": "#,0.00"
          },
          {
            "name": "Top Category Sales",
            "expression": "IF([Category Sales Rank]<=10,[Sales])",
            "lineageTag": "dfef1834-078d-5496-bc1d-25a70a000dcd",
            "displayFolder": "业务指标",
            "description": "销售额",
            "formatString": "#,0.00"
          },
          {
            "name": "Top Category Profit",
            "expression": "IF([Category Sales Rank]<=10,[Reported Profit])",
            "lineageTag": "a86eb0f1-c43d-5ec4-9bb7-507edf5fb087",
            "displayFolder": "业务指标",
            "description": "记录利润",
            "formatString": "#,0.00"
          },
          {
            "name": "Loss Category Rank",
            "expression": "RANKX(ALLSELECTED(dim_product[category]),[Negative Profit Magnitude],,DESC,DENSE)",
            "lineageTag": "c28336a8-801d-59be-8596-5ea3743a6dd2",
            "displayFolder": "业务指标",
            "description": "Loss Category Rank",
            "formatString": "#,0"
          },
          {
            "name": "Top Loss Magnitude",
            "expression": "IF([Loss Category Rank]<=10,[Negative Profit Magnitude])",
            "lineageTag": "6b061548-3ac8-5a45-9652-ef504ac0df50",
            "displayFolder": "业务指标",
            "description": "负利润明细绝对额",
            "formatString": "#,0.00"
          },
          {
            "name": "Top Loss Cumulative Share",
            "expression": "VAR CurrentLoss=[Negative Profit Magnitude]\nVAR TotalLoss=CALCULATE([Negative Profit Magnitude],ALLSELECTED(dim_product[category]))\nVAR CumulativeLoss=SUMX(FILTER(ALLSELECTED(dim_product[category]),[Negative Profit Magnitude]>=CurrentLoss),[Negative Profit Magnitude])\nRETURN IF([Loss Category Rank]<=10,DIVIDE(CumulativeLoss,TotalLoss))",
            "lineageTag": "874ad1bf-7a4f-52dc-9028-491d3610a759",
            "displayFolder": "业务指标",
            "description": "累计负利润占比",
            "formatString": "0.00%"
          },
          {
            "name": "Top Country Sales",
            "expression": "IF(RANKX(ALLSELECTED(dim_geography[country]),[Sales],,DESC,DENSE)<=10,[Sales])",
            "lineageTag": "e7481bae-7a90-568b-9d07-f317116f6d98",
            "displayFolder": "业务指标",
            "description": "记录销售额",
            "formatString": "#,0.00"
          },
          {
            "name": "Comparison Policy",
            "expression": "VAR CurrentMonth=SELECTEDVALUE(dim_date[order_month])\nRETURN IF(NOT HASONEVALUE(dim_date[order_month]),\"请按月查看\",\nIF(CurrentMonth>=\"2017-10\",\"待核验\",IF(SELECTEDVALUE(dim_date[is_comparable],0)=1,\"观察值比较\",\"不适用\")))",
            "lineageTag": "f78d46b9-b268-5cd1-93ff-241c651400e0",
            "displayFolder": "业务指标",
            "description": "同比/环比状态"
          },
          {
            "name": "Sales MoM",
            "expression": "VAR CurrentMonth=SELECTEDVALUE(dim_date[order_month])\nVAR StartDate=IF(NOT ISBLANK(CurrentMonth),DATE(VALUE(LEFT(CurrentMonth,4)),VALUE(RIGHT(CurrentMonth,2)),1))\nVAR PriorMonth=IF(NOT ISBLANK(StartDate),FORMAT(EDATE(StartDate,-1),\"yyyy-MM\"))\nVAR PriorAllowed=CALCULATE(MAX(dim_date[is_comparable]),REMOVEFILTERS(dim_date),dim_date[order_month]=PriorMonth)\nVAR PriorSales=CALCULATE([Sales],REMOVEFILTERS(dim_date),dim_date[order_month]=PriorMonth)\nRETURN IF(NOT ISBLANK(CurrentMonth)&&CurrentMonth<\"2017-10\"&&SELECTEDVALUE(dim_date[is_comparable],0)=1&&PriorAllowed=1,\nDIVIDE([Sales]-PriorSales,PriorSales))",
            "lineageTag": "84efc435-034c-5334-aacb-ffa8932f84ae",
            "displayFolder": "业务指标",
            "description": "金额观察值环比",
            "formatString": "0.00%"
          },
          {
            "name": "Sales YoY",
            "expression": "VAR CurrentMonth=SELECTEDVALUE(dim_date[order_month])\nVAR StartDate=IF(NOT ISBLANK(CurrentMonth),DATE(VALUE(LEFT(CurrentMonth,4)),VALUE(RIGHT(CurrentMonth,2)),1))\nVAR PriorMonth=IF(NOT ISBLANK(StartDate),FORMAT(EDATE(StartDate,-12),\"yyyy-MM\"))\nVAR PriorAllowed=CALCULATE(MAX(dim_date[is_comparable]),REMOVEFILTERS(dim_date),dim_date[order_month]=PriorMonth)\nVAR PriorSales=CALCULATE([Sales],REMOVEFILTERS(dim_date),dim_date[order_month]=PriorMonth)\nRETURN IF(NOT ISBLANK(CurrentMonth)&&CurrentMonth<\"2017-10\"&&SELECTEDVALUE(dim_date[is_comparable],0)=1&&PriorAllowed=1,\nDIVIDE([Sales]-PriorSales,PriorSales))",
            "lineageTag": "f8437744-425d-525f-acf0-490cfe47497a",
            "displayFolder": "业务指标",
            "description": "金额观察值同比",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "KPI",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Dummy=Int64.Type], {{1}})"
            }
          }
        ]
      }
    ],
