        "fromTable": "fact_order_items",
        "fromColumn": "product_id",
        "toTable": "dim_product",
        "toColumn": "product_id",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      }
    ],
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "LoadData",
        "kind": "m",
        "expression": "(name as text) as table =>\nlet\n    Source = Csv.Document(File.Contents(DataFolder & \"/\" & name & \".csv\"),\n        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    NumericNames = {\"order_id\",\"order_item_id\",\"product_id\",\"customer_id\",\"category_id\",\n        \"department_id\",\"geo_key\",\"shipping_mode_key\",\"quantity\",\"year\",\"month\",\"quarter\",\n        \"weekday\",\"observed_days\",\"days_in_month\",\"partial_month\",\"is_comparable\",\n        \"is_canceled\",\"is_over_schedule\",\"is_order_conflict\",\"item_count\",\"source_row\",\n        \"orders\",\"order_items\",\"planned_days_min\",\"planned_days_max\"},\n    RealNames = {\"sales\",\"gross_sales\",\"reported_profit\",\"discount\",\"discount_rate\",\n        \"unit_price\",\"actual_days\",\"planned_days\",\"positive_over_days\"},\n    Conversions = List.Transform(Table.ColumnNames(Headers), (c) =>\n        {c, if List.Contains(NumericNames,c) then Int64.Type\n            else if List.Contains(RealNames,c) then type number\n            else if c=\"date_key\" or c=\"date\" then type date\n            else if c=\"order_date\" or c=\"shipping_date\" then type datetime\n            else type text}),\n    EmptyToNull = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),\n    Typed = Table.TransformColumnTypes(EmptyToNull,Conversions,\"en-US\")\nin Typed"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataFolder\", \"LoadData\", \"dim_product\", \"dim_customer\", \"dim_date\", \"dim_geography\", \"dim_shipping\", \"fact_orders\", \"fact_order_items\", \"build_metadata\"]"
      }
    ]
  }
}
